4" title="John McLean" alt="John McLean"/><area href="https://en.wikipedia.org/wiki/Robert_Trimble" coords="176,330,299,353" title="Robert Trimble" alt="Robert Trimble"/><area href="https://en.wikipedia.org/wiki/Smith_Thompson" coords="244,319,367,341" title="Smith Thompson" alt="Smith Thompson"/><area href="https://en.wikipedia.org/wiki/Joseph_Story" coords="252,307,363,329" title="Joseph Story" alt="Joseph Story"/><area href="https://en.wikipedia.org/wiki/Gabriel_Duvall" coords="205,295,328,317" title="Gabriel Duvall" alt="Gabriel Duvall"/><area href="https://en.wikipedia.org/wiki/Thomas_Todd" coords="165,283,269,306" title="Thomas Todd" alt="Thomas Todd"/><area href="https://en.wikipedia.org/wiki/Henry_Brockholst_Livingston" coords="152,272,354,294" title="Henry Brockholst Livingston" alt="Henry Brockholst Livingston"/><area href="https://en.wikipedia.org/wiki/William_Johnson_(judge)" coords="203,260,332,282" title="William Johnson (judge)" alt="William Johnson (judge)"/><area href="https://en.wikipedia.org/wiki/John_Marshall" coords="207,248,324,270" title="John Marshall" alt="John Marshall"/><area href="https://en.wikipedia.org/wiki/Alfred_Moore" coords="67,236,178,259" title="Alfred Moore" alt="Alfred Moore"/><area href="https://en.wikipedia.org/wiki/Bushrod_Washington" coords="182,225,329,247" title="Bushrod Washington" alt="Bushrod Washington"/><area href="https://en.wikipedia.org/wiki/Oliver_Ellsworth" coords="53,213,188,235" title="Oliver Ellsworth" alt="Oliver Ellsworth"/><area href="https://en.wikipedia.org/wiki/Samuel_Chase" coords="100,201,210,223" title="Samuel Chase" alt="Samuel Chase"/><area href="https://en.wikipedia.org/wiki/William_Paterson_(judge)" coords="79,189,214,212" title="William Paterson (judge)" alt="William Paterson (judge)"/><area href="https://en.wikipedia.org/wiki/Thomas_Johnson_(judge)" coords="18,178,141,200" title="Thomas Johnson (judge)" alt="Thomas Johnson (judge)"/><area href="https://en.wikipedia.org/wiki/James_Iredell" coords="48,166,165,188" title="James Iredell" alt="James Iredell"/><area href="https://en.wikipedia.org/wiki/John_Blair_Jr." coords="30,154,129,176" title="John Blair Jr." alt="John Blair Jr."/><area href="https://en.wikipedia.org/wiki/James_Wilson_(Founding_Father)" coords="43,142,153,165" title="James Wilson (Founding Father)" alt="James Wilson (Founding Father)"/><area href="https://en.wikipedia.org/wiki/William_Cushing" coords="97,131,225,153" title="William Cushing" alt="William Cushing"/><area href="https://en.wikipedia.org/wiki/John_Rutledge" coords="31,119,148,141" title="John Rutledge" alt="John Rutledge"/><area href="https://en.wikipedia.org/wiki/John_Jay" coords="29,107,115,129" title="John Jay" alt="John Jay"/></map><img usemap="#timeline_3zrozxpitxftlxj5c0779bj6u90h4jo" src="//upload.wikimedia.org/wikipedia/en/timeline/3zrozxpitxftlxj5c0779bj6u90h4jo.png"/></div>

</section><section data-mw-section-id="4" id="mwD2A" aria-labelledby="See_also"><div class="mw-heading mw-heading2"><h2 id="See_also">See also</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=List_of_justices_of_the_Supreme_Court_of_the_United_States&amp;action=edit&amp;section=4" title="Edit section: See also"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
